<?xml version="1.0" encoding="utf-8"?>
<!-- Una burbuja de Webchat (paynani PRD #653 FR-8): lo del agente, a la izquierda y con su nombre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="left"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="64dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/wc_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_in"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/wc_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="@color/paynani_grana"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- La cita de una respuesta (paynani #745 FR-12): quién y una línea. Tocarla lleva al original. -->
        <include layout="@layout/webchat_quote" />

        <!-- Las fotos se ven aquí; los demás archivos, como tarjeta para descargar. -->
        <LinearLayout
            android:id="@+id/wc_files"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/wc_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web|phone"
            android:textColor="@color/paynani_tinta"
            android:textColorLink="@color/paynani_tinta"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Las reacciones (paynani #745 FR-10): cada emoji con su número; la del dueño, resaltada. -->
    <LinearLayout
        android:id="@+id/wc_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/wc_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:textColor="@color/paynani_gris"
        android:textSize="12sp" />
</LinearLayout>
