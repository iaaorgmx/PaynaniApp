<?xml version="1.0" encoding="utf-8"?>
<!-- Webchat sin emparejar (#7): qué es paynani, la guía, el prompt para pedir el QR y «Emparejar». -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textColor="@color/paynani_grana"
            android:textSize="24sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_body"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/welcome_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/welcome_guide"
            android:textColor="@color/paynani_grana"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <include layout="@layout/pair_prompt" />

        <Button
            android:id="@+id/welcome_pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/opt_pair" />
    </LinearLayout>
</ScrollView>
