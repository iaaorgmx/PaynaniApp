<?xml version="1.0" encoding="utf-8"?>
<!-- El prompt de ejemplo para pedirle el QR al agente, con «Copiar» (#7). Va en Webchat sin
     emparejar y en la pantalla de emparejar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pair_prompt_label"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pair_prompt_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/pair_prompt_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pair_prompt"
            android:textColor="@color/paynani_tinta"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/pair_prompt_copy"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/pair_prompt_copy"
            android:textColor="@color/paynani_grana" />
    </LinearLayout>
</LinearLayout>
