<?xml version="1.0" encoding="utf-8"?>
<!-- «Mensajes de Telegram» (paynani PRD #609 FR-29a): los hilos de Telegram, sin mensaje nuevo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:orientation="vertical">

    <!-- El estado del bot cuando no está funcionando (TELEGRAM.md §4: offline, conflict, token_invalid…). -->
    <TextView
        android:id="@+id/tg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_warn_bg"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/status_warn_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- El Catch-All de Telegram (PaynaniApp #164, Q264 = A): sólo si la pasarela anuncia catchall.get. -->
    <TextView
        android:id="@+id/tg_catchall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/tg_catchall_row"
        android:textColor="@color/paynani_grana"
        android:textSize="15sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/tg_threads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <!-- Cargando, sin hilos, sin conexión o error con «Reintentar». -->
        <LinearLayout
            android:id="@+id/tg_threads_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/tg_threads_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tg_threads_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/paynani_gris"
                android:textSize="15sp" />

            <Button
                android:id="@+id/tg_threads_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/tg_retry"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
